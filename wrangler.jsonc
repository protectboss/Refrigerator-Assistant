// Cloudflare Workers 部署配置:worker.js 负责 /api 代理与家庭同步,webapp/ 为静态资源
{
  "name": "refrigerator-assistant",
  "main": "worker.js",
  "compatibility_date": "2026-05-03",
  "assets": {
    "directory": "webapp",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FRIDGE_DO",
        "class_name": "FridgeStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FridgeStore"]
    }
  ]
}
