.page {
  padding: 24rpx;
}

.section-title {
  font-size: 26rpx;
  color: var(--text-2);
  margin: 8rpx 0 16rpx;
  font-weight: 500;
}

.section-sub {
  font-size: 22rpx;
  color: var(--text-3);
  margin-left: 12rpx;
  font-weight: 400;
}

/* 推荐卡片 */
.rec-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.rec {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.rec-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rec-name {
  font-size: 32rpx;
  font-weight: 600;
}

.rec-time {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--text-3);
}

.ing-row {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}

.ing-label {
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 44rpx;
  flex-shrink: 0;
}

.ing-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.rec-brief {
  font-size: 24rpx;
  color: var(--text-2);
  padding-top: 4rpx;
  border-top: 1rpx solid var(--stroke);
}

/* 购物清单 */
.shopping {
  padding: 0 24rpx;
}

.shopping-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--stroke);
  font-size: 28rpx;
}

.shopping-item:last-child {
  border-bottom: none;
}

.shopping-remove {
  font-size: 22rpx;
  color: var(--text-3);
}

.go-add-btn {
  margin-top: 24rpx;
  background: var(--primary);
  color: #fff;
  font-size: 28rpx;
  border-radius: 999rpx;
  display: inline-block;
}

.go-add-btn::after {
  border: none;
}
